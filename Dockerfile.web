FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-web.txt requirements-deploy.txt ./
RUN pip install --no-cache-dir -r requirements-deploy.txt
COPY pearl ./pearl
COPY scripts ./scripts
COPY app.py ./
RUN useradd --create-home bot && mkdir /app/data && chown bot:bot /app/data
USER bot
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "exec gunicorn app:app --bind 0.0.0.0:${PORT:-8080} --workers 1 --threads 4 --timeout 90"]
